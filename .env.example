# ==============================================================================
# Multi-Domain AI Recommendation System (CineAI V2.0 + MusicAI)
# Environment Configuration Template
# ==============================================================================

# Scientific Computing Thread Allocation (Prevents memory thrashing on Windows/Linux)
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
OMP_NUM_THREADS=1
PYTHONUNBUFFERED=1

# Application Metadata
PROJECT_NAME="Multi-Domain AI Recommendation System (CineAI + MusicAI)"
VERSION="1.0.0"
DEFAULT_MUSIC_MODEL="item_cf"

# Network & Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000

# CORS Allowed Origins
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000"]
