# ==============================================================================
# Multi-Domain AI Recommendation System (CineAI V2.0 + MusicAI)
# Environment Configuration Template
# ==============================================================================

# Scientific Computing Thread Allocation (Prevents memory thrashing on Windows/Linux)
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
OMP_NUM_THREADS=1
PYTHONUNBUFFERED=1

# Application Metadata
PROJECT_NAME="Multi-Domain AI Recommendation System (CineAI + MusicAI)"
VERSION="1.0.0"
DEFAULT_MUSIC_MODEL="item_cf"

# Network & Ports
PORT=8000
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Memory Management (Default: 2 models per domain to protect < 512MB RAM constraints; 6+ for 2GB Starter tier)
MAX_CACHED_MODELS=2

# CORS Allowed Origins (Comma-separated for Backend)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000,https://ai-recommendation-system.vercel.app"

# Artifacts Download URL (For Render cloud container bootstrap when volumes are not mounted)
# Example: ARTIFACTS_DOWNLOAD_URL="https://github.com/HoangTuan1301/AI-Recommendation-System/releases/download/v1.0.0-artifacts/production_artifacts.tar.gz"
ARTIFACTS_DOWNLOAD_URL=""

# Frontend API URL (Set on Vercel Dashboard for Vite production build)
# Example: VITE_API_BASE_URL="https://ai-recommendation-system.onrender.com"
VITE_API_BASE_URL=""
