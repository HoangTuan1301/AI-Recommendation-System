# ==============================================================================
# Multi-Domain AI Recommendation System (CineAI V2.0 + MusicAI)
# Backend Production Dockerfile
# Base: Python 3.11 Slim | Non-Root User | OpenBLAS Optimized
# ==============================================================================

FROM python:3.11-slim AS base

# System dependencies for scientific computing and health checks
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Create unprivileged application user
RUN groupadd -g 10001 appgroup && \
    useradd -u 10001 -g appgroup -s /bin/bash -m appuser

WORKDIR /app

# Ensure single-threaded OpenBLAS to prevent memory thrashing
ENV OPENBLAS_NUM_THREADS=1 \
    MKL_NUM_THREADS=1 \
    OMP_NUM_THREADS=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app

# Install Python production dependencies
COPY backend/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -U pip setuptools wheel && \
    pip install --no-cache-dir -r requirements.txt

# Copy source code, modules, checkpoints, and utilities
COPY --chown=appuser:appgroup backend /app/backend
COPY --chown=appuser:appgroup src /app/src
COPY --chown=appuser:appgroup app /app/app
COPY --chown=appuser:appgroup models /app/models
COPY --chown=appuser:appgroup scripts /app/scripts

# Create mount points and directories for runtime data and checkpoints
RUN mkdir -p /app/data/processed \
             /app/data/music/processed \
             /app/models/checkpoints/music \
             /app/results \
             /app/reports/musicai && \
    chown -R appuser:appgroup /app

# Switch to unprivileged user
USER appuser

EXPOSE 8000

# Health Check supporting dynamic port
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -f http://localhost:${PORT:-8000}/api/v1/health || exit 1

# Start container: ensures model artifacts exist, then starts Uvicorn
CMD ["sh", "-c", "python scripts/ensure_artifacts.py && uvicorn backend.app.main:app --host 0.0.0.0 --port ${PORT:-8000} --workers 1"]
