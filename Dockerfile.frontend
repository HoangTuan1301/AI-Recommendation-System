# ==============================================================================
# Multi-Domain AI Recommendation System (CineAI V2.0 + MusicAI)
# Frontend Multi-Stage Production Dockerfile
# Stage 1: Vite + TypeScript Production Build
# Stage 2: Unprivileged Nginx Alpine Runner
# ==============================================================================

# --- Stage 1: Build Environment ---
FROM node:20-alpine AS builder

WORKDIR /app

# Install dependencies first (layer caching)
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci

# Copy frontend source code and configs
COPY frontend/ ./

# Compile TypeScript and bundle production assets with code splitting
RUN npm run build

# --- Stage 2: Production Nginx Runner (Non-root user 101) ---
FROM nginxinc/nginx-unprivileged:alpine AS runner

# Copy customized reverse-proxy and SPA Nginx configuration
COPY frontend/nginx.conf /etc/nginx/conf.d/default.conf

# Copy compiled static assets from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 8080

# Health check probing unprivileged port 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -q --spider http://localhost:8080/ || exit 1

CMD ["nginx", "-g", "daemon off;"]
