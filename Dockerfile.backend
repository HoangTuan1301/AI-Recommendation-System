# ==============================================================================
# Multi-Domain AI Recommendation System (CineAI V2.0 + MusicAI)
# Backend Production Dockerfile
# Base: Python 3.11 Slim | Non-Root User | OpenBLAS Optimized
# ==============================================================================

FROM python:3.11-slim AS base

# System dependencies for scientific computing and health checks
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Create unprivileged application user
RUN groupadd -g 10001 appgroup && \
    useradd -u 10001 -g appgroup -s /bin/bash -m appuser

WORKDIR /app

# Ensure single-threaded OpenBLAS to prevent memory thrashing
ENV OPENBLAS_NUM_THREADS=1 \
    MKL_NUM_THREADS=1 \
    OMP_NUM_THREADS=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONPATH=/app

# Install Python production dependencies
COPY backend/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -U pip setuptools wheel && \
    pip install --no-cache-dir -r requirements.txt

# Copy source code and backend modules
COPY --chown=appuser:appgroup backend /app/backend
COPY --chown=appuser:appgroup src /app/src

# Create mount points for external data and checkpoint volumes
RUN mkdir -p /app/data/processed \
             /app/data/music/processed \
             /app/models/checkpoints/music \
             /app/results && \
    chown -R appuser:appgroup /app

# Switch to unprivileged user
USER appuser

EXPOSE 8000

# Health Check using FastAPI built-in health endpoint
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
    CMD curl -f http://localhost:8000/api/v1/health || exit 1

CMD ["uvicorn", "backend.app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "1"]
